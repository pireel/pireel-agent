{
  "name": "pireel-agent",
  "version": "0.7.8",
  "private": true,
  "description": "Source for the Pireel agent plugin. The version above is the only hand-written one: scripts/build-channel.mjs stamps it into every published manifest.",
  "license": "Apache-2.0",
  "repository": "https://github.com/pireel/pireel-agent",
  "scripts": {
    "build": "node scripts/build-channel.mjs",
    "check": "node scripts/build-channel.mjs --check",
    "build:local": "node scripts/build-channel.mjs local --out .local",
    "pack:local": "node scripts/build-channel.mjs local --out .local && rm -f .local/pireel-local.plugin && (cd .local/plugins/pireel-local-claude && zip -qr ../../pireel-local.plugin . -x '.DS_Store')",
    "test": "node --test scripts/build-channel.test.mjs"
  }
}
